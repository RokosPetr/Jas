@page "{id?}"
@model Jas.Areas.Srv.Pages.DetailModel
@using Jas.Globals.Srv.Enums

@{
    ViewData["Title"] = "Detail požadavku";
    var statusText = Model.Request.Status switch
    {
        (int)Status.New        => "Nová",
        (int)Status.InProgress => "V procesu",
        (int)Status.Resolved   => "Vyřízeno",
        (int)Status.Cancelled  => "Zrušeno",
        _                      => "Neznámý"
    };

    var categoryText = Model.Request.RepairCategory switch
    {
        (int)RepairCategory.Light   => "Lehká (60 dní)",
        (int)RepairCategory.Serious => "Vážná (30 dní)",
        (int)RepairCategory.Urgent  => "Urgentní (5 dní)",
        _                           => "Neznámá"
    };
}

<h1>@ViewData["Title"]</h1>

@if (Model.Request == null)
{
    <p>Požadavek nebyl nalezen.</p>
}
else
{
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Request.Id)</dt>
        <dd class="col-sm-9">@Model.Request.Id</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Request.Department)</dt>
        <dd class="col-sm-9">@Model.Request.Department</dd>

        <dt class="col-sm-3">Zadal</dt>
        <dd class="col-sm-9">@Model.CreatedByName</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Request.IssueDescription)</dt>
        <dd class="col-sm-9">@Model.Request.IssueDescription</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Request.RepairDescription)</dt>
        <dd class="col-sm-9">@Model.Request.RepairDescription</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Request.RepairCategory)</dt>
        <dd class="col-sm-9">@categoryText</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Request.Status)</dt>
        <dd class="col-sm-9">@statusText</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Request.CreatedDate)</dt>
        <dd class="col-sm-9">
            @Model.Request.CreatedDate.ToString("dd.MM.yyyy HH:mm")
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Request.PlannedRepairDate)</dt>
        <dd class="col-sm-9">
            @(Model.Request.PlannedRepairDate.HasValue
                ? Model.Request.PlannedRepairDate.Value.ToString("dd.MM.yyyy HH:mm")
                : "")
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Request.DueDate)</dt>
        <dd class="col-sm-9">
            @(Model.Request.DueDate.HasValue
                ? Model.Request.DueDate.Value.ToString("dd.MM.yyyy HH:mm")
                : "")
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Request.RemovedDate)</dt>
        <dd class="col-sm-9">
            @(Model.Request.RemovedDate.HasValue
                ? Model.Request.RemovedDate.Value.ToString("dd.MM.yyyy HH:mm")
                : "")
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Request.EstimatedCost)</dt>
        <dd class="col-sm-9">
            @(Model.Request.EstimatedCost?.ToString("N0") ?? "")
        </dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Request.ActualCost)</dt>
        <dd class="col-sm-9">
            @(Model.Request.ActualCost?.ToString("N0") ?? "")
        </dd>
    </dl>

    <div class="mt-3">
        <a asp-area="Srv" asp-page="/Index" class="btn btn-secondary">
            Zpět na přehled
        </a>

        @if (User.IsInRole("SRV - admin"))
        {
            <a asp-area="Srv"
               asp-page="/Create"
               asp-route-id="@Model.Request.Id"
               class="btn btn-primary ms-2">
                Upravit požadavek
            </a>
        }
    </div>
}