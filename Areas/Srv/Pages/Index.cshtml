@page "{filter?}"
@model Jas.Areas.Srv.Pages.IndexModel
@using Jas.Globals.Srv.Enums
@using X.PagedList.Mvc.Core

@{
    var activeFilter = (ViewContext.RouteData.Values["filter"] as string) ?? string.Empty;

    // Titulek podle aktivního stavu
    var title = activeFilter switch
    {
        "new-requests"        => "Přehled nových požadavků na údržbu",
        "inprogress-requests" => "Přehled řešených požadavků na údržbu",
        "toconfirm-requests"  => "Přehled požadavků na údržbu k odsouhlašení",
        "resolved-requests"   => "Přehled vyřízených požadavků na údržbu",
        "returned-requests"   => "Přehled vrácených požadavků na údržbu",
        "cancelled-requests"  => "Přehled zrušených požadavků na údržbu",
        _                      => "Přehled požadavků na údržbu"
    };

    ViewData["Title"] = title;

    var paged = Model.PagedRequests;

    bool hasAny = paged != null && paged.Count > 0;
}

<h1>@ViewData["Title"]</h1>

<form method="get" class="mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label" for="DepartmentFilterId">Středisko:</label>
            <select asp-for="DepartmentFilterId"
                    class="form-select"
                    asp-items="@(new SelectList(Model.Departments, "Id", "Name", Model.DepartmentFilterId))">
                <option value="">-- Všechna střediska --</option>
            </select>
        </div>

        @* filtr vytvořeno od *@
        <div class="col-auto">
            <label class="form-label" asp-for="CreatedFrom">Vytvořeno od:</label>
            <input asp-for="CreatedFrom" type="date" class="form-control" />
        </div>

        @* filtr vytvořeno do *@
        <div class="col-auto">
            <label class="form-label" asp-for="CreatedTo">Vytvořeno do:</label>
            <input asp-for="CreatedTo" type="date" class="form-control" />
        </div>

        <div class="col-auto">
            <button type="submit" class="btn btn-primary d-print-none">Filtrovat</button>
            <a asp-page="./IndexPrint" 
               asp-route-filter="@activeFilter" 
               asp-route-DepartmentFilterId="@Model.DepartmentFilterId"
               asp-route-CreatedFrom="@Model.CreatedFrom?.ToString("yyyy-MM-dd")"
               asp-route-CreatedTo="@Model.CreatedTo?.ToString("yyyy-MM-dd")"
               target="_blank"
               class="btn btn-outline-info ms-2 d-print-none" 
               title="Tisk celého seznamu">
                <span aria-hidden="true">&#128438;</span> Tisk seznamu
            </a>
        </div>
    </div>
</form>

@if (Model.PagedRequests != null && Model.PagedRequests.PageCount > 1)
{
    @Html.PagedListPager(
        Model.PagedRequests,
        page => Url.Page("./Index", new
        {
            filter = activeFilter,
            pageNumber = page,
            DepartmentFilterId = Model.DepartmentFilterId,
            CreatedFrom = Model.CreatedFrom?.ToString("yyyy-MM-dd"),
            CreatedTo = Model.CreatedTo?.ToString("yyyy-MM-dd")
        }),
        new PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" },
            UlElementClasses = new[] { "pagination" },
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            DisplayLinkToIndividualPages = true
        })
}

@if (!hasAny)
{
    <p>Žádné požadavky k zobrazení.</p>
}
else
{
    var newRequests        = paged.Where(r => r.Status == (int)Status.New).ToList();
    var inProgressRequests = paged.Where(r => r.Status == (int)Status.InProgress).ToList();
    var toConfirmRequests  = paged.Where(r => r.Status == (int)Status.ToConfirm).ToList();
    var resolvedRequests   = paged.Where(r => r.Status == (int)Status.Resolved).ToList();
    var returnedRequests   = paged.Where(r => r.Status == (int)Status.Returned).ToList();
    var cancelledRequests  = paged.Where(r => r.Status == (int)Status.Cancelled).ToList();

    @* NOVÉ *@
    if (activeFilter == "new-requests" && newRequests.Count > 0)
    {
        <table class="table table-striped table-bordered table-sm w-100">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Requests[0].Id)</th>
                    <th>@Html.DisplayNameFor(m => m.Requests[0].Department)</th>
                    <th>@Html.DisplayNameFor(m => m.Requests[0].RepairCategory)</th>
                    <th>@Html.DisplayNameFor(m => m.Requests[0].CreatedDate)</th>
                    <th>@Html.DisplayNameFor(m => m.Requests[0].DueDate)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in newRequests)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Department</td>

                    @* RepairCategory / RepairCategoryAdmin *@
                    <td>
                        @Model.GetFormattedCategoryText(item.RepairCategory, item.RepairCategoryAdmin)
                    </td>

                    <td>@item.CreatedDate.ToString("dd.MM.yyyy")</td>

                    @* DueDate + (datum podle původní RepairCategory) *@
                    <td>
                        @Model.GetFormattedRepairDateText(item.CreatedDate, item.RepairCategory, item.RepairCategoryAdmin)
                    </td>

                    <td class="text-end">
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-icon-sm" title="Upravit">
                            <span aria-hidden="true">&#9998;</span>
                            <span class="visually-hidden">Upravit</span>
                        </a>
                        <a asp-page="./DetailPrint" asp-route-id="@item.Id" class="btn btn-outline-info btn-icon-sm ms-1" target="_blank" title="Tisk">
                            <span aria-hidden="true">&#128438;</span>
                            <span class="visually-hidden">Tisk</span>
                        </a>
                    </td>
                </tr>
                <tr>
                        <td colspan="7" class="bg-white text-dark">
                            <span class="fw-bold me-2">
                                @Html.DisplayNameFor(m => m.Requests[0].IssueDescription):
                            </span>
                            @item.IssueDescription
                        </td>
                </tr>
            }
            </tbody>
        </table>
    }

    @* K POTVRZENÍ *@
    if (activeFilter == "toconfirm-requests" && toConfirmRequests.Count > 0)
    {
        <table class="table table-striped table-bordered table-sm w-100">
            <thead class="table-light">
                <tr>
                    <th>Č.p.</th>
                    <th>Uživatel</th>
                    <th>Středisko</th>
                    <th>Opravit do</th>
                    <th>Odstraněno</th>
                    <th>Předpokládané nák.</th>
                    <th>Skutečné nák.</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in toConfirmRequests)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.UserName</td>
                        <td>@item.Department</td>
                        <td>
                            @Model.GetFormattedRepairDateText(item.CreatedDate, item.RepairCategory, item.RepairCategoryAdmin)
                        </td>
                        <td>
                            @(item.RemovedDate.HasValue
                                            ? item.RemovedDate.Value.ToString("dd.MM.yyyy")
                                            : "")
                        </td>
                        <td>
                            @(item.EstimatedCost.HasValue
                                            ? item.EstimatedCost.Value.ToString("N0")
                                            : "")
                        </td>
                        <td>
                            @(item.ActualCost.HasValue
                                            ? item.ActualCost.Value.ToString("N0")
                                            : "")
                        </td>
                        <td class="text-end">
                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-icon-sm" title="Detail">
                                <span aria-hidden="true">&#9998;</span>
                                <span class="visually-hidden">Detail</span>
                            </a>
                            <a asp-page="./DetailPrint" asp-route-id="@item.Id" class="btn btn-outline-info btn-icon-sm ms-1" target="_blank" title="Tisk">
                                <span aria-hidden="true">&#128438;</span>
                                <span class="visually-hidden">Tisk</span>
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="8" class="bg-white text-dark">
                            <span class="fw-bold me-2">
                                @Html.DisplayNameFor(m => m.Requests[0].IssueDescription):
                            </span>
                            @item.IssueDescription
                            @if (!string.IsNullOrWhiteSpace(item.RepairDescription))
                            {
                                <br />

                                <span class="fw-bold me-2">
                                    @Html.DisplayNameFor(m => m.Requests[0].RepairDescription):
                                </span>
                                @item.RepairDescription
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* V PROCESU *@
    if (activeFilter == "inprogress-requests" && inProgressRequests.Count > 0)
    {
        <table class="table table-striped table-bordered table-sm w-100">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Requests[0].Id)</th>
                    <th>Uživatel</th>
                    <th>Středisko</th>
                    <th>@Html.DisplayNameFor(m => m.Requests[0].CreatedDate)</th>
                    <th>@Html.DisplayNameFor(m => m.Requests[0].DueDate)</th>
                    <th>@Html.DisplayNameFor(m => m.Requests[0].PlannedRepairDate)</th>
                    <th>@Html.DisplayNameFor(m => m.Requests[0].EstimatedCost)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in inProgressRequests)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.UserName</td>
                    <td>@item.Department</td>
                    <td>@item.CreatedDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        @Model.GetFormattedRepairDateText(item.CreatedDate, item.RepairCategory, item.RepairCategoryAdmin)
                    </td>
                    <td>
                        @(item.PlannedRepairDate.HasValue
                            ? item.PlannedRepairDate.Value.ToString("dd.MM.yyyy")
                            : "")
                    </td>
                    <td>
                        @(item.EstimatedCost.HasValue
                            ? item.EstimatedCost.Value.ToString("N0")
                            : "")
                    </td>
                    <td class="text-end">
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-icon-sm" title="Upravit">
                            <span aria-hidden="true">&#9998;</span>
                            <span class="visually-hidden">Upravit</span>
                        </a>
                        <a asp-page="./DetailPrint" asp-route-id="@item.Id" class="btn btn-outline-info btn-icon-sm ms-1" target="_blank" title="Tisk">
                            <span aria-hidden="true">&#128438;</span>
                            <span class="visually-hidden">Tisk</span>
                        </a>
                    </td>
                </tr>
                    <tr>
                        <td colspan="8" class="bg-white text-dark">
                            <span class="fw-bold me-2">
                                @Html.DisplayNameFor(m => m.Requests[0].IssueDescription):
                            </span>
                            @item.IssueDescription
                            @if (!string.IsNullOrWhiteSpace(item.RepairDescription))
                            {
                                <br /><span class="fw-bold me-2">
                                    @Html.DisplayNameFor(m => m.Requests[0].RepairDescription):
                                </span>
                                    @item.RepairDescription
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* VYŘÍZENÉ *@
    if (activeFilter == "resolved-requests" && resolvedRequests.Count > 0)
    {
        <table class="table table-striped table-bordered table-sm w-100">
            <thead class="table-light">
                <tr>
                    <th>Č.p.</th>
                    <th>Uživatel</th>
                    <th>Středisko</th>
                    <th>Opravit do</th>
                    <th>Odstraněno</th>
                    <th>Předpokládané nák.</th>
                    <th>Skutečné nák.</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in resolvedRequests)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.UserName</td>
                        <td>@item.Department</td>
                        <td>
                            @Model.GetFormattedRepairDateText(item.CreatedDate, item.RepairCategory, item.RepairCategoryAdmin)
                        </td>
                        <td>
                            @(item.RemovedDate.HasValue
                                            ? item.RemovedDate.Value.ToString("dd.MM.yyyy")
                                            : "")
                        </td>
                        <td>
                            @(item.EstimatedCost.HasValue
                                            ? item.EstimatedCost.Value.ToString("N0")
                                            : "")
                        </td>
                        <td>
                            @(item.ActualCost.HasValue
                                            ? item.ActualCost.Value.ToString("N0")
                                            : "")
                        </td>
                        <td class="text-end">
                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-icon-sm" title="Upravit">
                                <span aria-hidden="true">&#9998;</span>
                                <span class="visually-hidden">Upravit</span>
                            </a>
                            <a asp-page="./DetailPrint" asp-route-id="@item.Id" class="btn btn-outline-info btn-icon-sm ms-1" target="_blank" title="Tisk">
                                <span aria-hidden="true">&#128438;</span>
                                <span class="visually-hidden">Tisk</span>
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="8" class="bg-white text-dark">
                            <span class="fw-bold me-2">
                                @Html.DisplayNameFor(m => m.Requests[0].IssueDescription):
                            </span>
                            @item.IssueDescription
                            @if (!string.IsNullOrWhiteSpace(item.RepairDescription))
                            {
                                <br />
                
                                <span class="fw-bold me-2">
                                    @Html.DisplayNameFor(m => m.Requests[0].RepairDescription):
                                </span>
                                @item.RepairDescription
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* ZRUŠENÉ *@
    if (activeFilter == "cancelled-requests" && cancelledRequests.Count > 0)
    {
        <table class="table table-striped table-bordered table-sm w-100">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(m => m.Requests[0].Id)</th>
                    <th>Uživatel</th>
                    <th>Středisko</th>
                    <th>@Html.DisplayNameFor(m => m.Requests[0].RemovedDate)</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in cancelledRequests)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.UserName</td>
                        <td>@item.Department</td>
                        <td>
                            @(item.RemovedDate.HasValue
                                            ? item.RemovedDate.Value.ToString("dd.MM.yyyy")
                                            : "")
                        </td>
                        <td class="text-end">
                            <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-icon-sm" title="Upravit">
                                <span aria-hidden="true">&#9998;</span>
                                <span class="visually-hidden">Upravit</span>
                            </a>
                            <a asp-page="./DetailPrint" asp-route-id="@item.Id" class="btn btn-outline-info btn-icon-sm ms-1" target="_blank" title="Tisk">
                                <span aria-hidden="true">&#128438;</span>
                                <span class="visually-hidden">Tisk</span>
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="8" class="bg-white text-dark">
                            <span class="fw-bold me-2">
                                @Html.DisplayNameFor(m => m.Requests[0].IssueDescription):
                            </span>
                            @item.IssueDescription
                            @if (!string.IsNullOrWhiteSpace(item.RepairDescription))
                            {
                                <br />

                                <span class="fw-bold me-2">
                                    @Html.DisplayNameFor(m => m.Requests[0].RepairDescription):
                                </span>
                                @item.RepairDescription
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* VRÁCENÉ *@
    if (activeFilter == "returned-requests" && returnedRequests.Count > 0)
    {
        <table class="table table-striped table-bordered table-sm w-100">
            <thead class="table-light">
                <tr>
                    <th>Č.p.</th>
                    <th>Uživatel</th>
                    <th>Středisko</th>
                    <th>Opravit do</th>
                    <th>Odstraněno</th>
                    <th>Předpokládané nák.</th>
                    <th>Skutečné nák.</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in returnedRequests)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.UserName</td>
                    <td>@item.Department</td>
                    <td>
                        @Model.GetFormattedRepairDateText(item.CreatedDate, item.RepairCategory, item.RepairCategoryAdmin)
                    </td>
                    <td>
                        @(item.RemovedDate.HasValue
                            ? item.RemovedDate.Value.ToString("dd.MM.yyyy")
                            : "")
                    </td>
                    <td>
                        @(item.EstimatedCost.HasValue
                            ? item.EstimatedCost.Value.ToString("N0")
                            : "")
                    </td>
                    <td>
                        @(item.ActualCost.HasValue
                            ? item.ActualCost.Value.ToString("N0")
                            : "")
                    </td>
                    <td class="text-end">
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-icon-sm" title="Upravit">
                            <span aria-hidden="true">&#9998;</span>
                            <span class="visually-hidden">Upravit</span>
                        </a>
                        <a asp-page="./DetailPrint" asp-route-id="@item.Id" class="btn btn-outline-info btn-icon-sm ms-1" target="_blank" title="Tisk">
                            <span aria-hidden="true">&#128438;</span>
                            <span class="visually-hidden">Tisk</span>
                        </a>
                    </td>
                </tr>
                <tr>
                    <td colspan="8" class="bg-white text-dark">
                        <span class="fw-bold me-2">
                            @Html.DisplayNameFor(m => m.Requests[0].IssueDescription):
                        </span>
                        @item.IssueDescription

                        @* Popis opravy *@
                        @if (!string.IsNullOrWhiteSpace(item.RepairDescription))
                        {
                            <br />
                            <span class="fw-bold me-2">
                                @Html.DisplayNameFor(m => m.Requests[0].RepairDescription):
                            </span>
                            @item.RepairDescription
                        }

                        @* Důvod vrácení, pokud ho máš v modelu (ReturnDescription) *@
                        @if (!string.IsNullOrWhiteSpace(item.ReturnDescription))
                        {
                            <br />
                            <span class="fw-bold me-2">
                                Důvod vrácení:
                            </span>
                            @item.ReturnDescription
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
}