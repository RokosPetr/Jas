@page
@model Jas.Areas.Srv.Pages.IndexInTimeModel
@using Jas.Globals.Srv.Enums
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Nevyřešené požadavky po termínu";
    var paged = Model.PagedRequests;
    bool hasAny = paged != null && paged.Count > 0;
}

<h1>@ViewData["Title"]</h1>

<form method="get" class="mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-auto">
            <label class="form-label" for="DepartmentFilterId">Středisko:</label>
            <select asp-for="DepartmentFilterId"
                    class="form-select"
                    asp-items="@(new SelectList(Model.Departments, "Id", "Name", Model.DepartmentFilterId))">
                <option value="">-- Všechna střediska --</option>
            </select>
        </div>

        <div class="col-auto">
            <button type="submit" class="btn btn-primary d-print-none">Filtrovat</button>
            <button type="button" class="btn btn-outline-info ms-2 d-print-none" onclick="window.print();" title="Tisk seznamu">
                <span aria-hidden="true">&#128438;</span> Tisk seznamu
            </button>
        </div>
    </div>
</form>

@if (Model.PagedRequests != null && Model.PagedRequests.PageCount > 1)
{
    @Html.PagedListPager(
        Model.PagedRequests,
        page => Url.Page("./IndexInTime", new
        {
            pageNumber = page,
            DepartmentFilterId = Model.DepartmentFilterId
        }),
        new PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" },
            UlElementClasses = new[] { "pagination" },
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            DisplayLinkToIndividualPages = true
        })
}

@if (!hasAny)
{
    <p>Žádné nevyřešené požadavky po termínu k zobrazení.</p>
}
else
{
    <table class="table table-striped table-bordered table-sm w-100">
        <thead class="table-light">
            <tr>
                <th>Č.p.</th>
                <th>Středisko</th>
                <th>Kategorie opravy</th>
                <th>Vytvořeno</th>
                <th>Opravit do</th>
                <th>Stav</th>
                <th class="d-print-none"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in paged!)
            {
                var statusText = item.Status switch
                {
                    (int)Status.New        => "Nová",
                    (int)Status.InProgress => "V procesu",
                    (int)Status.ToConfirm  => "K potvrzení",
                    (int)Status.Returned   => "Vráceno",
                    _                      => "Neznámý"
                };

                <tr>
                    <td>@item.Id</td>
                    <td>@item.Department</td>
                    <td>@Model.GetFormattedCategoryText(item.RepairCategory, item.RepairCategoryAdmin)</td>
                    <td>@item.CreatedDate.ToString("dd.MM.yyyy")</td>
                    <td>@Model.GetFormattedRepairDateText(item.CreatedDate, item.RepairCategory, item.RepairCategoryAdmin)</td>
                    <td>@statusText</td>
                    <td class="text-end d-print-none">
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-icon-sm" title="Upravit">
                            <span aria-hidden="true">&#9998;</span>
                            <span class="visually-hidden">Upravit</span>
                        </a>
                        <a asp-page="./DetailPrint" asp-route-id="@item.Id" class="btn btn-outline-info btn-icon-sm ms-1" target="_blank" title="Tisk">
                            <span aria-hidden="true">&#128438;</span>
                            <span class="visually-hidden">Tisk</span>
                        </a>
                    </td>
                </tr>
                <tr>
                    <td colspan="7" class="bg-white text-dark">
                        <span class="fw-bold me-2">Popis závady:</span> @item.IssueDescription
                        @if (!string.IsNullOrWhiteSpace(item.RepairDescription))
                        {
                            <br /><span class="fw-bold me-2">Popis opravy:</span> @item.RepairDescription
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<style>
    @@media print {
        .d-print-none { display: none !important; }
        .table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ccc; padding: 6px; text-align: left; }
        th { background-color: #f8f9fa; font-weight: bold; }
        .bg-white { padding-bottom: 15px; }
    }
</style>
