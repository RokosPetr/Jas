@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@inject UserManager<Jas.Data.JasIdentityApp.JasUser> UserManager

@{
    Layout = null; // Protože chceme, aby to vracel komponent navigační lišty nezávisle na rozložení stánky a _Layout to sem začlení
}

<nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark border-bottom box-shadow mb-3">
    <div class="container">
        <a class="navbar-brand" asp-area="" asp-page="/Index">Jas Intranet</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
            <ul class="navbar-nav flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="Intranet" asp-page="/Index">Domů</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-area="Intranet" asp-page="/GnRewards">Odměny GN</a>
                </li>
            </ul>
        </div>

        <div id="top-panel-dropdown">
            <div id="cart-holder">
                <span class="user">@User.Identity?.Name</span>
            </div>
            <div id="top-panel-dropdown-menu">
                <a asp-area="Identity"
                   asp-page="/Account/Logout"
                   asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")">
                    Odhlásit
                </a>
            </div>
        </div>
    </div>
</nav>