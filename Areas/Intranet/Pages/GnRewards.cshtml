@page
@model Jas.Areas.Intranet.Pages.GnRewardsModel

@{
    ViewData["Title"] = "Seznam Odměn (GnRewards)";
}

@section Styles {
    <link rel="stylesheet" href="~/css/intranet.min.css" asp-append-version="true" />
}

<partial name="Shared/_Navbar" />

<div class="container mt-4">
    <!-- FILTRY (SLICERY) V PŘEVZATÉM EXCEL STYLU-->
    <div class="mb-4">
        <div class="d-flex gap-2 mb-3">
            <!-- Slicer: Prodejna -->
            <div class="slicer-box bg-white border rounded">
                <style>
                    .slicer-item.selected {
                        background-color: #0d6efd !important;
                        color: white !important;
                    }
                </style>
                <div class="slicer-header bg-light border-bottom p-1 d-flex justify-content-between align-items-center">
                    <span class="font-weight-bold" style="font-size:12px;">Prodejna</span>
                    <button type="button" class="btn btn-sm btn-link p-0 text-danger clear-slicer" data-target="stores" title="Zrušit filtr">&#10005;</button>
                </div>
                <div class="slicer-body overflow-auto" style="height: 405px; width:150px; padding:2px;">
                    @foreach(var store in Model.AllStores)
                    {
                        <div class="slicer-item p-1 border rounded mb-1 text-truncate" data-value="@store" data-group="stores" style="font-size:12px; cursor:pointer;" title="@store">
                            @store
                        </div>
                    }
                </div>
            </div>

            <!-- Slicer: Osoba -->
            <div class="slicer-box bg-white border rounded">
                <div class="slicer-header bg-light border-bottom p-1 d-flex justify-content-between align-items-center">
                    <span class="font-weight-bold" style="font-size:12px;">Osoba</span>
                    <button type="button" class="btn btn-sm btn-link p-0 text-danger clear-slicer" data-target="persons" title="Zrušit filtr">&#10005;</button>
                </div>
                <div class="slicer-body overflow-auto" style="height: 405px; width:150px; padding:2px;">
                    @foreach(var person in Model.AllPersons)
                    {
                        <div class="slicer-item p-1 border rounded mb-1 text-truncate" data-value="@person" data-group="persons" style="font-size:12px; cursor:pointer;" title="@person">
                            @person
                        </div>
                    }
                </div>
            </div>

            <!-- Slicer: Rok -->
            <div class="slicer-box bg-white border rounded">
                <div class="slicer-header bg-light border-bottom p-1 d-flex justify-content-between align-items-center">
                    <span class="font-weight-bold" style="font-size:12px;">Rok</span>
                    <button type="button" class="btn btn-sm btn-link p-0 text-danger clear-slicer" data-target="years" title="Zrušit filtr">&#10005;</button>
                </div>
                <div class="slicer-body overflow-auto" style="height: 405px; width:100px; padding:2px;">
                    @foreach(var year in Model.AllYears)
                    {
                        <div class="slicer-item p-1 border rounded mb-1 text-center" data-value="@year" data-group="years" style="font-size:12px; cursor:pointer;">
                            @year
                        </div>
                    }
                </div>
            </div>

            <!-- Slicer: Měsíc -->
            <div class="slicer-box bg-white border rounded">
                <div class="slicer-header bg-light border-bottom p-1 d-flex justify-content-between align-items-center">
                    <span class="font-weight-bold" style="font-size:12px;">Měsíc</span>
                    <button type="button" class="btn btn-sm btn-link p-0 text-danger clear-slicer" data-target="months" title="Zrušit filtr">&#10005;</button>
                </div>
                <div class="slicer-body overflow-auto" style="height: 405px; width:100px; padding:2px;">
                    @foreach(var month in Model.AllMonths)
                    {
                        <div class="slicer-item p-1 border rounded mb-1" data-value="@month" data-group="months" style="font-size:12px; cursor:pointer;">
                            @month
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- PIVOT TABULKA CONTANER PRO AJAX -->
    <div id="pivotContainer" class="w-100 mb-5">
        <p class="text-muted">Načítám kontingenční tabulku...</p>
    </div>

