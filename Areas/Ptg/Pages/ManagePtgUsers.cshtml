@page
@using X.PagedList.Mvc.Core
@model Jas.Areas.Ptg.Pages.ManagePtgUsersModel
@{
    ViewData["Title"] = "Zákazníci";
}

<div class="container my-5">
    <h1>@ViewData["Title"]</h1>

    <form method="get" class="mb-3" role="search">
        <div class="input-group w-50">
            <input asp-for="Search" class="form-control" placeholder="Filtrovat podle uživatelského jména nebo e-mailu..." />
            <button type="submit" class="btn btn-primary">Hledat</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <a asp-page="./ManagePtgUsers" class="btn btn-outline-secondary">Zrušit</a>
            }
        </div>
    </form>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="alert alert-success">@statusMessage</div>
    }

    <form method="post">
        <input type="hidden" asp-for="Search" />
        <input type="hidden" asp-for="PageNumber" />

        @Html.PagedListPager(Model.PagedUsers, page => Url.Page("./ManagePtgUsers", new { pageNumber = page, Search = Model.Search }),
        new PagedListRenderOptions
        {
            LiElementClasses = new[] { "page-item" },
            PageClasses = new[] { "page-link" },
            UlElementClasses = new[] { "pagination" },
            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
            DisplayLinkToLastPage = PagedListDisplayMode.Always,
            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
            DisplayLinkToNextPage = PagedListDisplayMode.Always,
            DisplayLinkToIndividualPages = true
        })

        <table class="table table-striped table-bordered table-sm align-middle w-100">
            <thead class="table-light">
                <tr>
                    <th class="text-center">Přístup</th>
                    <th>Uživatel</th>
                    <th>E-mail</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted">Žádní uživatelé neodpovídají filtru.</td>
                    </tr>
                }
                else
                {
                    @for (int i = 0; i < Model.Users.Count; i++)
                    {
                        <tr>
                            <td class="text-center">
                                <input asp-for="Users[i].IsPtgVoUser" class="form-check-input" />
                            </td>
                            <td>
                                @Model.Users[i].UserName
                                <input type="hidden" asp-for="Users[i].Id" />
                                <input type="hidden" asp-for="Users[i].UserName" />
                                <input type="hidden" asp-for="Users[i].Email" />
                            </td>
                            <td>
                                @Model.Users[i].Email
                                <a asp-page="./EditCustomer"
                                   asp-route-id="@Model.Users[i].Id"
                                   asp-route-ReturnSearch="@Model.Search"
                                   class="btn btn-sm btn-outline-secondary ms-2">
                                    Upravit
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">Uložit</button>
    </form>
</div>
