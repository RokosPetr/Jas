@page "/ptg/user-stand-print/{id:int}"
@model Jas.Areas.Ptg.Pages.UserStandPrintModel

@{
    Layout = null;
}

@await Html.PartialAsync("_PieceStandPrint", Model)

@if (Model.ChangeTexts.Any())
{
    <div style="page-break-before: always; padding: 24px 32px;">
        <h1>Seznam provedených změn</h1>
        <ul>
            @foreach (var changeText in Model.ChangeTexts)
            {
                if (!string.IsNullOrWhiteSpace(changeText))
                {
                    <li>@changeText</li>
                }
            }
        </ul>
    </div>
}
