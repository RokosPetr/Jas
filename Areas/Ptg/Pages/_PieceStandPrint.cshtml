@model Jas.Areas.Ptg.Pages.StandPrintModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title></title>
    @{
        var css = System.IO.File.ReadAllText(System.IO.Path.Combine(Directory.GetCurrentDirectory(), "wwwroot/css/ptg-piece-tag.min.css"));

        var match = System.Text.RegularExpressions.Regex.Match(css, @"--ptg-piece-padding\s*:\s*([^;]+);");
        if (match.Success)
        {
            var paddingValue = match.Groups[1].Value.Trim();

            css = System.Text.RegularExpressions.Regex.Replace(css, @"var\(--ptg-piece-padding\)", paddingValue);
        }

        // origin pro OpenSansCssBuilder
        var origin = $"{Context.Request.Scheme}://{Context.Request.Host}";
        var openSansCss = Jas.Services.OpenSansCssBuilder.Build("https://ptg.koupelnyprokazdeho.cz");
    }
    <style>
        @Html.Raw(openSansCss)
        @Html.Raw(css)
    </style>
</head>
<body class="ptg-print">

    @Html.DisplayFor(m => m.PlateItems, "/Areas/Ptg/Pages/Shared/DisplayTemplates/PieceTag.cshtml", additionalViewData: new { PrintQr = Model.PrintQr, VoPrice = Model.VoPrice })

    @await Html.PartialAsync("/Areas/Ptg/Pages/_ChangeTextsPrint.cshtml", Model)

</body>
</html>
