@model List<Jas.Models.Ptg.PlateItem>
@using System.Globalization

@{
    var printQr = (bool?)ViewData["PrintQr"] ?? false;
    var voPrice = (bool?)ViewData["VoPrice"] ?? false;

    void RenderPieceTag(Jas.Models.Ptg.PlateItem item, bool printQr, bool voPrice)
    {
        if (item == null)
        {
            return;
        }

        <text>
            <div class="piece-price-tag @(item.TagType == 3 ? "sanity" : "")" id="reg_@item.RegNumber">

                <div class="piece-price-tag-head">
                    <span class="name" style="@(item.TagType != 3 ? item.StyleTagName : "")">@item.TagName</span>
                    @if (item.TagType == 3)
                    {
                        <br />

                        <span class="description">@Html.Raw(item.TagDescription.Replace("-", "&#8209;"))</span>
                    }

                </div>

                <div class="piece-price-tag-top @(item.Discarded && !item.ToSellout ? "discarded" : "") @((item.PlateQr is null && item.Qr is null) || !printQr || item.Discarded ? " noqr" : "")">
                    <div class="size"><span>@item.SizeType1</span></div>
                    <img class="symbols" src="@item.SymbolsImage" />
                    @if (item.ToSellout)
                    {
                        <div class="to-sellout" style="right: @((item.SymbolsCount * 20) + 10)px;">
                            <span>DO VYPRODÁNÍ</span>
                        </div>
                    }
                    <div class="price@(item.Discount && !voPrice ? " discount" : "")">
                        <span class="price">
                            @(!item.Discarded || item.ToSellout
                                                ? string.Format(new System.Globalization.CultureInfo("cs-CZ"), "{0:N0}", voPrice ? item.PriceNn : item.PriceJas) + ",-"
                                                : "VYŘAZENO")
                        </span>
                        <span class="unit">@item.Unit</span>
                    </div>

                </div>

                <div class="piece-price-tag-bottom @(item.Discarded && !item.ToSellout ? "discarded" : "") @((item.PlateQr is null && item.Qr is null) || !printQr || (item.Discarded && !item.ToSellout) ? " noqr" : "")">
                    <img class="qr" src="@item.QrBase64" />
                    <div class="reg"><span>Index: @item.RegNumber</span></div>
                    <div class="dph"><span>Uvedená cena je včetně DPH.</span></div>
                    <div class="info">
                        <span>Pro podrobnější informace naskenujte do mobilního telefonu QR kód, kontaktujte prodejce u pultu nebo použijte dotykový panel na prodejně.</span>
                    </div>
                </div>

            </div>
        </text>
    }
}

@{
    const int itemsPerPage = 12; // 12 štítků na stránku (6 řádků po 2)
}

@for (int i = 0; i < Model.Count; i += 2)
{
    if (i % itemsPerPage == 0)
    {
        if (i > 0)
        {
            @Html.Raw("</tbody></table>")
        }

        @Html.Raw("<table class=\"page\"><tbody>")
    }

    <tr>
        <td>
            @{
                RenderPieceTag(Model[i], printQr, voPrice);
            }
        </td>
        <td>
            @if (i + 1 < Model.Count)
            {
                RenderPieceTag(Model[i + 1], printQr, voPrice);
            }
        </td>
    </tr>

    if (i + 2 >= Model.Count)
    {
        @Html.Raw("</tbody></table>")
    }
}
