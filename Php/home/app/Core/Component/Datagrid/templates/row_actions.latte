{varType App\Core\Component\Datagrid\BaseAction $rowAction}

{foreach $cellsTemplates as $cellsTemplate}
    {import $cellsTemplate}
{/foreach}

<td class="row-actions">
    {var array $sortedActions = App\Core\Component\Datagrid\BaseDatagrid::sortActions($rowActions[$row->id] ?? [], ['preview'], ['edit', 'delete', 'restore'])}
    {foreach $sortedActions as $rowAction}
        {var string $actionLink = $rowAction->currentPresenter ? ":$presenter->name:" . rtrim($rowAction->linkAction, '!') : $rowAction->link}
        <a target="{$rowAction->target}" class="{$rowAction->getClassList()|implode:' '}"
            {if isset($rowAction->modalData['targetId'])}
                data-toggle="modal"
                data-target="#{$rowAction->modalData['targetId']}"
                data-type="{$rowAction->linkAction}"
                data-id="{$row->id}"
            {elseif $rowAction->actionParams}
                href="{plink $actionLink, (expand) $rowAction->getActionParams($row)}"
            {else}
                href="{plink $actionLink, id => $row->id}"
            {/if}

            {if $rowAction->dialog}
                data-dialog-title="{$rowAction->dialog['title']}"
                data-dialog-text="{$rowAction->dialog['text']}"
            {/if}

            {if !empty($rowAction->sideDialogData['history'])}
                data-sd-history="on"
            {/if}
        >
            <span data-toggle="tooltip" title="{$rowAction->label}" class="fa fa-{$rowAction->getIconImage()}"></span>
            {if isset($rowAction->iconSuffix) && $row->{$rowAction->iconSuffix} !== 0}
                <span class="actionSuffix-{$rowAction->iconSuffix}"
                      style="
                          position: relative;
                          background: rgba(0,160,20,1);
                          height:2rem;
                          top:-10px;
                          right:5px;
                          width:2rem;
                          text-align: center;
                          font-family: Sans-serif;
                          line-height: 2rem;
                          font-weight: bold;
                          font-size: 1rem;
                          border-radius: 50%;
                          color:white;
                          border:1px solid green;"
                >&nbsp;{$row->{$rowAction->iconSuffix}}&nbsp;</span>
            {/if}
        </a>
    {/foreach}

    {if $hasActionsColumn}
        {ifset #row-actions}
            {include #row-actions row => $row, primary => $primary}
        {/ifset}
    {/if}
</td>
