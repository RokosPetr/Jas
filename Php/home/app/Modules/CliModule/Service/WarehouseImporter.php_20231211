/**
 * Sluzba pro import skladovych dat
 *  - Polozky (vykon) skladniku
 *  - Zasoby pobocek
 *  - Povinny sortiment pobocek
 */
class WarehouseImporter
{
    private OrmModel $orm;

    public function __construct(OrmModel $orm)
    {
        $this->orm = $orm;
    }

    /** Import polozek (vykon) skladniku */
    public function importWarehousemanItems(): \stdClass
    {
        $importName = 'Položky skladníků';
        $import = $this->orm->imports->getImportByName($importName);

        $result = new \stdClass();
        $result->deletedCount = 0;
        $result->importCount = 0;

        $fileName = 'polozky_hod.csv';
        $filePath = DATA_DIR . "/sklad/$fileName";

        if (!file_exists($filePath)) {
            $result->error = "Import neproběhl. Nelze načíst zdrojový soubor '$fileName'";
            return $result;
        }

        if ($import && $import->date->getTimestamp() >= filemtime($filePath)) {
            $result->error = 'Import neproběhl, data jsou aktuální (' . $import->date->format(DateTime::CZ_DATETIME) . ')';
            return $result;
        }

        $handle = fopen($filePath, 'r');
        $this->orm->warehousemanItems->beginTransaction();

        try {
            $deleteOld = true;
            $importItems = [];

            while (($data = fgetcsv($handle, 1000, ';')) !== false) {
                if ($deleteOld) {
                    $year = DateTime::createFromFormat(DateTime::DB_DATE, $data[5])->format('Y');
                    $result->deletedCount = $this->orm->warehousemanItems->deleteByYear((int) $year);
                    $deleteOld = false;
                }

                $webId = intval($data[3] ?? null);
                $quantity = intval($data[4] ?? null);
                $date = $data[5] ?? null;

                if (!$webId || !$quantity || !$date) {
                    continue;
                }

                $result->importCount++;
                $importItems[] = [
                    'web_id' => $webId,
                    'quantity' => $quantity,
                    'date' => $date
                ];

                if ($result->importCount % 500 === 0) {
                    $this->orm->warehousemanItems->insertItems($importItems);
                    $importItems = [];
                }
            }

            if ($importItems) {
                $this->orm->warehousemanItems->insertItems($importItems);
            }

            if (!$import) {
                $this->orm->imports->insertEntity(null, [
                    'name' => $importName,
                    'date' => (new DateTime())->setTimestamp(filemtime($filePath))
                ]);
            } else {
                $import->date = (new DateTime())->setTimestamp(filemtime($filePath));
                $import->getRepository()->persistAndFlush($import);
            }

            $this->orm->warehousemanItems->commitTransaction();
        } catch (\Exception $e) {
            $this->orm->warehousemanItems->rollbackTransaction();
            throwDebug($e);
            $result->error = $e->getMessage();
        }

        fclose($handle);
        return $result;
    }

    /** Import skladovych zasob vybrane pobocky */
    public function importStockItems(int $storeId): string
    {
        $storeName = $this->orm->stores->getById($storeId)->name ?? '?';
        $importName = "Skladové položky - $storeName";
        $import = $this->orm->imports->getImportByName($importName);

        $zipName = 'intranet.zip';
        $fileName = 'intranet.csv';
        $zip = new \ZipArchive();

        if ($zip->open(DATA_DIR . "/$storeId/$zipName") !== true) {
            return "Import skladových zásob pobočky '$storeName' neproběhl. Nelze načíst zdrojový soubor '$zipName'";
        }

        $fileStats = $zip->statName($fileName);

        if (!$fileStats) {
            $zip->close();
            return "Import skladových zásob pobočky '$storeName' neproběhl. Nelze načíst zdrojový soubor '$fileName'";
        }

        if ($import && $import->date->getTimestamp() >= $fileStats['mtime'] && false) {
            $zip->close();
            return "Import skladových zásob pobočky '$storeName' neproběhl, data jsou aktuální (" . $import->date->format(DateTime::CZ_DATETIME) . ')';
        }

        $fp = $zip->getStream($fileName);

        $i = 0;
        $fileContent = '';
        $fileContent_2 = '';
        while (!feof($fp)) {
            if($i<=50000){
                $fileContent .= fgets($fp);
            }
            else{
                $fileContent_2 .= fgets($fp);
            }
            $i++;
        }
        fclose($fp);
        //file_put_contents(DATA_DIR . "/$storeId/intranet_1.csv",$contents);
        file_put_contents(DATA_DIR . "/$storeId/intranet_2.csv",$fileContent_2);

        //$fileContent = $zip->getFromName($fileName);

        $zip->close();

        $localStockItems = $this->orm->stockItems->findAll()->fetchPairs('regNumber', 'id');
        $newStockItems = [];
        $imports = [];
        $separator = "\r\n";
        $line = strtok(iconv('WINDOWS-1250', 'UTF-8', $fileContent), $separator);

        while ($line !== false) {
            $csvData = str_getcsv($line, ';');

            if (strlen($csvData[3]) !== 1 && count($csvData) < 14) {
                // Fix when supplement === '\'
                array_splice($csvData, 3, 0, "\\");
                $csvData[4] = str_replace('\";', '', rtrim($csvData[4], '"'));

                if (count($csvData) < 14 && Strings::startsWith($csvData[4], '";')) {
                    array_splice($csvData, 4, 0, '');
                    $csvData[5] = str_replace('";', '', $csvData[5]);
                }
            }

            $importData = new StoreStockImport();
            $importData->regNumber = trim($csvData[0]);
            $importData->name = trim($csvData[1]);
            // fix to remove non-breaking space pro catalog name
            $importData->catalog = trim(str_replace("\xc2\xa0", ' ', $csvData[2])) ?: null;
            $importData->supplement = $csvData[3];
            $importData->remark = trim($csvData[4]) ?: null;
            $importData->producer = (int) trim($csvData[5]);
            $importData->group = (int) trim($csvData[6]);
            $importData->price = (float) str_replace(',', '.', trim($csvData[7]));
            $importData->quantity = (float) trim($csvData[8]);
            $importData->unit = trim($csvData[9]);
            $importData->paletteQuantity = (float) str_replace(',', '.', trim($csvData[11]));
            $importData->weight = (int) trim($csvData[12]);
            $importData->sector = trim($csvData[13]) ?: null;

            if (!isset($localStockItems[$importData->regNumber])) {
                $newStockItems[] = $importData;
                $localStockItems[$importData->regNumber] = true;
            }

            $imports[] = $importData;
            $line = strtok($separator);
        }

        $this->insertNewStockItems($newStockItems);
        $this->updateStockVariants($storeId, $imports);
        $this->updateStockVariantLocalCatalogs($storeId, $imports);

        if (!$import) {
            $this->orm->imports->insertEntity(null, [
                'name' => $importName,
                'date' => (new DateTime())->setTimestamp($fileStats['mtime'])
            ]);
        } else {
            $import->date = (new DateTime())->setTimestamp($fileStats['mtime']);
            $import->getRepository()->persistAndFlush($import);
        }

        return "Import skladových zásob pobočky '$storeName' proběhl úspěšně (načteno " . count($imports) . (' položek)');
    }

    /** Aktualizace cen zbozi */
    public function updateItemPrice(): string
    {
        $zipName = 'intranet.zip';
        $fileName = 'intranet.csv';
        $zip = new \ZipArchive();

        if ($zip->open(DATA_DIR . '/' . Store::OSTRAVA_MAIN_STORAGE . "/$zipName") !== true) {
            return "Update cen neproběhl, nelze načíst soubor '$zipName'";
        }

        $fileStats = $zip->statName($fileName);

        if (!$fileStats) {
            $zip->close();
            return "Update cen neproběhl, nelze načíst zdrojový soubor '$fileName'";
        }

        $fileContent = $zip->getFromName($fileName);
        $zip->close();

        $stockItems = $this->orm->stockItems->findAll()->fetchPairs('regNumber');
        $separator = "\r\n";
        $line = strtok(iconv('WINDOWS-1250', 'UTF-8', $fileContent), $separator);

        while ($line !== false) {
            $csvData = str_getcsv($line, ';');

            if (strlen($csvData[3]) !== 1 && count($csvData) < 14) {
                // Fix when supplement === '\'
                array_splice($csvData, 3, 0, "\\");
                $csvData[4] = str_replace('\";', '', rtrim($csvData[4], '"'));
            }

            $regNumber = trim($csvData[0]);
            $price = (float) str_replace(',', '.', trim($csvData[7]));
            /** @var StockItem $stockItem */
            $stockItem = $stockItems[$regNumber] ?? null;

            if ($stockItem && $stockItem->price !== $price) {
                $stockItem->price = $price;
                $this->orm->stockItems->persist($stockItem);
            }

            unset($stockItems[$regNumber]);
            $line = strtok($separator);
        }

        $this->orm->stockItems->flush();
        return '';
    }

