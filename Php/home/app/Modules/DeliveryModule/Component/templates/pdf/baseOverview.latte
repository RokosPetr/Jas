{varType App\Modules\DeliveryModule\Component\BaseOverview $overviewControl}
{varType array $columns}
{varType array $years}
{varType bool $hasCurrentYear}
{varType bool $isTotalValue}
{varType array $charts}
{varType string $subject}
{varType string $company}
{varType string $stockItem}

<div>
    <h1>Srovnání odběrů</h1>
    <h2>{$subject}</h2>
    <h2 n:if="$company">Společnost: {$company}</h2>
    <h2 n:if="$stockItem">Předmět: {$stockItem}</h2>
</div>

<div style="page-break-before: always;">
<table class="overview">
    <thead>
        <tr>
            <th class="odd"></th>
            <th n:foreach="array_values($columns) as $index => $columnName" colspan="{count($years)}" n:class="$index % 2 ? odd : even">{$columnName}</th>
            <th colspan="{count($years)}" n:class="$index % 2 ? even : odd">Celkem</th>
        </tr>
    </thead>

    <tbody>
        <tr>
            <td class="month year-head-cell">Rok</td>
            {for $i = 0; $i < count($columns) + 1; $i++}
                <td n:foreach="$years as $year" n:class="year-cell, $i % 2 ? odd : even, $iterator->isLast() ? no-right-border"><b>{$year}</b></td>
            {/for}
        </tr>

        {var array $tableData = [],
            array $rowSums = [],
            array $columnIds = array_keys($columns),
            int $maxCompareMonth = $hasCurrentYear ? (date('n') - 1)  : 12,
            int $mostPastYear = end($years),
            int $value = 0,
            int $compareValue = 0
        }

        {foreach App\Core\Utils\DateTime::CZ_MONTHS as $month => $monthName}
            <tr>
                <td class="month">{$monthName |firstUpper}</td>
                {foreach $columnIds as $index => $columnId}
                    {foreach $years as $year}
                        {php $tableData[$columnId][$mostPastYear][$month] ??= ($isTotalValue ? $overviewControl->loadCellTotalValue($columnId, $mostPastYear, $month) : $overviewControl->loadCellValue($columnId, $mostPastYear, $month));
                            $tableData[$columnId][$year][$month] ??= ($isTotalValue ? $overviewControl->loadCellTotalValue($columnId, $year, $month) : $overviewControl->loadCellValue($columnId, $year, $month));
                            $rowSums[$year][$month] ??= 0;
                            $rowSums[$year][$month] += $tableData[$columnId][$year][$month]
                        }
                        {include #dataCell cellClass => $index % 2 ? 'odd' : 'even', value => $tableData[$columnId][$year][$month], compareValue => $tableData[$columnId][$mostPastYear][$month], year => $year, month => $month, mostPastYear => $mostPastYear}
                    {/foreach}
                {/foreach}

                {foreach $years as $year}
                    {var string $noRightBorderClass = $iterator->isLast() ? ' no-right-border' : ''}
                    {include #dataCell cellClass => $index % 2 ? ('even' . $noRightBorderClass) : ('odd' . $noRightBorderClass), value => $rowSums[$year][$month], compareValue => $rowSums[$mostPastYear][$month], year => $year, month => $month, mostPastYear => $mostPastYear}
                {/foreach}
            </tr>

            {if $month % 3 === 0}
                <tr>
                    <td class="month-sum">Celkem {$month - 2}-{$month}</td>
                    {foreach $columnIds as $index => $columnId}
                        {foreach $years as $year}
                            {php $value = $overviewControl->getPartSumValue($tableData[$columnId][$year], $month, $maxCompareMonth);
                                $compareValue = $overviewControl->getPartSumValue($tableData[$columnId][$mostPastYear], $month, $maxCompareMonth)
                            }
                            {include #dataCell cellClass => $index % 2 ? 'sum-cell-even' : 'sum-cell-odd', value => $value, compareValue => $compareValue, year => $year, month => $month - 2, mostPastYear => $mostPastYear}
                        {/foreach}
                    {/foreach}

                    {foreach $years as $year}
                        {php $value = $overviewControl->getPartSumValue($rowSums[$year], $month, $maxCompareMonth);
                            $compareValue = $overviewControl->getPartSumValue($rowSums[$mostPastYear], $month, $maxCompareMonth)
                        }
                        {var string $noRightBorderClass = $iterator->isLast() ? ' no-right-border' : ''}
                        {include #dataCell cellClass => $index % 2 ? ('sum-cell-odd' . $noRightBorderClass) : ('sum-cell-even' . $noRightBorderClass), value => $value, compareValue => $compareValue, year => $year, month => $month - 2, mostPastYear => $mostPastYear}
                    {/foreach}
                </tr>
            {/if}
        {/foreach}

        <tr n:if="!($hasCurrentYear && intval(date('n')) === 1)">
            <td class="month"></td>
            {var int $lastColIndex = count($columnIds)}
            {for $i = 0; $i < $lastColIndex + 1; $i++}
                <td n:for="$j = 0; $j < count($years); $j++" n:class="$i % 2 ? odd : even, ($i === $lastColIndex && $j === count($years) - 1) ? no-right-border">&nbsp;</td>
            {/for}
        </tr>

        <tr n:if="!($hasCurrentYear && intval(date('n')) === 1)">
            {var array $columnCompareSums = []}
            <td class="month-sum">Celkem 1-{$maxCompareMonth}</td>
            {foreach $columnIds as $index => $columnId}
                {foreach $years as $year}
                    {php $columnCompareSums[$year][$columnId] ??= 0}
                    {for $i = 1; $i <= $maxCompareMonth; $i++}
                        {php $columnCompareSums[$year][$columnId] += $tableData[$columnId][$year][$i]}
                    {/for}
                {/foreach}
                {foreach $years as $year}
                    {include #dataCell cellClass => $index % 2 ? 'sum-cell-even' : 'sum-cell-odd', value => $columnCompareSums[$year][$columnId], compareValue => $columnCompareSums[$mostPastYear][$columnId], year => $year, month => 1, mostPastYear => $mostPastYear}
                {/foreach}
            {/foreach}

            {foreach $years as $year}
                {var string $noRightBorderClass = $iterator->isLast() ? ' no-right-border' : ''}
                {include #dataCell cellClass => $index % 2 ? ('sum-cell-odd' . $noRightBorderClass) : ('sum-cell-even' . $noRightBorderClass), value => array_sum($columnCompareSums[$year]), compareValue => array_sum($columnCompareSums[$mostPastYear]), year => $year, month => 1, mostPastYear => $mostPastYear}
            {/foreach}
        </tr>
    </tbody>
</table>
</div>

{var string $firstChart = array_shift($charts)}
{var int $chartCounter = 0}

<div n:if="$firstChart" class="new-page">
    <img src="{$firstChart |noescape|nocheck}" alt="chart">
</div>

{foreach $charts as $chart}
    {if $chartCounter === 0}<div class="new-page">{/if}
        <img src="{$chart |noescape|nocheck}" alt="chart">
    {php $chartCounter++}
    {if $chartCounter === 6}</div>{php $chartCounter = 0}{/if}
{/foreach}


{define dataCell}
    {varType string $cellClass}
    {varType int $value}
    {varType int $compareValue}
    {varType int $year}
    {varType int $month}
    {varType int $mostPastYear}
    <td class="data-cell {$cellClass}">
        {$value |number:0,',',' '}
        {if $compareValue && $year !== $mostPastYear && ($year !== intval(date('Y')) || $month < intval(date('n')))}
            {var float $diff = (($value - $compareValue) / $compareValue) * 100}
            <br>
            <span n:class="$diff > 0 ? positive-value : negative-value">{if $diff > 0}+{/if}{$diff |number:1,',',' '} %</span>
        {/if}
    </td>
{/define}
