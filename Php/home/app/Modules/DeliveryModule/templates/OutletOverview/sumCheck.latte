{varType App\Modules\DeliveryModule\Orm\DeliveryNotes\NoteItem[] $noteItems}
{varType string $store}
{varType string $outlet}
{varType int $year}
{varType string $month}
{block content}
<h3>{$store} - {$outlet}</h3>
<h3>Měsíc: {$month} ({$year})</h3>
<table class="table datagrid-table jambo_table">
    <thead>
    <tr>
        <th style="width: 130px;">Číslo dokladu</th>
        <th>Pohyb</th>
        <th>Datum</th>
        <th>Pobočka</th>
        <th>Položka</th>
        <th style="width: 150px;">Suma</th>
        <th></th>
    </tr>
    </thead>

    <tbody>
    {var float $totalSum = 0}
    {var callable $isCancel = function (int $movement): bool { return in_array($movement, [App\Modules\DeliveryModule\Orm\DeliveryNotes\DeliveryNote::TYPE_CANCEL, App\Modules\DeliveryModule\Orm\DeliveryNotes\DeliveryNote::TYPE_TRANSFER_IN]); }}
    <tr n:foreach="$noteItems as $noteItem" n:class="$isCancel($noteItem->note->movementType) ? legend_red">
        <td>{$noteItem->note->number}</td>
        <td>0{$noteItem->note->movementNumber}</td>
        <td>{$noteItem->note->date |date:'d.m.Y'}</td>
        <td>{$noteItem->note->store->name}</td>
        <td>{$noteItem->item->name}</td>
        <td style="text-align: right;">{if $isCancel($noteItem->note->movementType)}-{/if}{$noteItem->sellSum |number:0,',',' '} Kč</td>
        <td>
            <a class="side-dialog" data-sd-history="on" href="{plink :Delivery:DeliveryNote:preview id => $noteItem->note->id}">
                <span class="fa fa-search"></span>
            </a>
        </td>
        {if $isCancel($noteItem->note->movementType)}
            {php $totalSum -= $noteItem->sellSum}
        {else}
            {php $totalSum += $noteItem->sellSum}
        {/if}
    </tr>
    <tr>
        <td style="text-align: right;" colspan="5"><b>Suma</b></td>
        <td style="text-align: right;">{$totalSum |number:0,',',' '} Kč</td>
        <td>{count($noteItems)} položek</td>
    </tr>
    </tbody>
</table>