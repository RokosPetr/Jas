{varType Nextras\Orm\Collection\ICollection $items}
{varType App\Modules\StockModule\Orm\StockItems\StockItem $stockItem}

{block content}
<div class="jas-search-input-wrapper">
    <input id="stock-item-search-input" class="jas-search-input" required type="text" autocomplete="off" title="Produkt k vyhledání" value="{$search}">
    <span class="floating-label">Název produktu, registrační číslo, katalogové číslo...</span>
</div>

<div n:snippet="searched-items">
    <table n:if="$items && $items->count()" class="table datagrid-table jambo_table">
        <thead>
            <tr>
                <th>Registrační číslo</th>
                <th></th>
                <th>Katalogové číslo</th>
                <th>Centrální sklad</th>
                <th>Jednotka</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            <tr n:foreach="$items as $stockItem">
                <td><a n:href="variants id => $stockItem->id" title="Množství na prodejnách">{$stockItem->regNumber}</a></td>
                <td>
                    <a target="_self" class="side-dialog" n:href="preview id => $stockItem->id" data-sd-history="on">{$stockItem->name}</a>
                </td>
                <td>{$stockItem->catalog ?? '-'}</td>
                <td>{$stockItem->mainStorageQuantity}</td>
                <td>{$stockItem->unit->name}</td>
                <td class="row-actions">
                    <a target="_self" class="side-dialog" n:href="preview id => $stockItem->id" data-sd-history="on">
                        <span data-toggle="tooltip" title="Náhled množství na prodejnách" class="fa fa-search"></span>
                    </a>
                    <a n:href="variants id => $stockItem->id">
                        <span data-toggle="tooltip" title="Množství na prodejnách" class="fa fa-cubes"></span>
                    </a>
                </td>
                {if !$showAll}{breakIf $iterator->counter === 10}{/if}
            </tr>
        </tbody>
    </table>

    <div n:if="!$showAll && $items && $items->count() > 10">
        Zobrazuje se jen 10 z {$items->count()} nalezených záznamů.
        <a href="#" id="show-all-items">Zobrazit vše</a>
    </div>

    <script n:if="!$showAll">
        $('#show-all-items').click(function (e) {
            e.preventDefault();
            $.nette.ajax({
                url: {link UpdateSearchItems! showAll => true},
                data: { search: $('#stock-item-search-input').val() }
            });
        });
    </script>
</div>

<script>
    initSearch();

    function initSearch() {
        var updatingInProgress = false;
        var updateSearchTimeout = null;
        var searchInput = $('#stock-item-search-input');

        searchInput.on('input', function () {
            var search = searchInput.val();

            if (search.length < 3) {
                if (updatingInProgress) {
                    clearTimeout(updateSearchTimeout);
                    updatingInProgress = false;
                }

                $('#snippet--searched-items').html('<h1></h1>');
                return;
            }

            if (updatingInProgress) {
                clearTimeout(updateSearchTimeout);
            }

            updatingInProgress = true;
            updateSearchTimeout = setTimeout(function () {
                updatingInProgress = false;
                $.nette.ajax({
                    url: {link UpdateSearchItems!},
                    data: { search }
                });
            }, 300);
        });
    }
</script>