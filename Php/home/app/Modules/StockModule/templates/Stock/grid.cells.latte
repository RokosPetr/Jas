{varType App\Modules\StockModule\Orm\StockItems\StockItem $row}

{define cell-producer}
    {$row->producer->name ?? '-'}
{/define}

{define cell-group}
    {$row->group->title ?? '-'}
{/define}

{define cell-unit}
    {$row->unit->name ?? '-'}
{/define}

{define cell-status}
    {App\Modules\StockModule\Orm\StockItems\StockItem::STATUSES[$row->status]}
{/define}
