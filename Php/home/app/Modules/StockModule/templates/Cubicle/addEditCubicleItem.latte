{varType App\Modules\StockModule\Orm\Cubicles\Cubicle $cubicle}
{block content}
<div class="jas-link-wrapper">
    <a title="Zpět na položky kóje" n:href="cubicleItems id => $cubicle->id">
        <img width="20" height="20" src="/image/zpet.png">
        <strong> zpět na položky kóje</strong>
    </a>
</div>
<h2>{$cubicle->title}</h2>
{control cubicleItemForm}
<script>
    initProductSearch('frm-cubicleItemForm-item');
</script>